---
import MainLayout from '@/components/layout/MainLayout.astro';
import { Button } from '@/components/ui/button';
import { ThreeBeatHook } from '@/components/content/ThreeBeatHook';
import { GITHUB_URL } from '@/config/navigation';
---

<MainLayout title="web3ready.org | The Manifesto">
  <main class="flex-1 flex flex-col items-center">
    <!-- Hero Section -->
    <section class="w-full max-w-[1200px] px-6 md:px-20 lg:px-40 py-20 lg:py-32">
      <div class="terminal-border relative p-8 md:p-16 bg-primary/5 rounded-sm overflow-hidden">
        <div class="absolute top-0 left-0 w-full h-1 bg-primary/30"></div>
        <div class="flex flex-col gap-8 items-start">
          <div class="space-y-4">
            <h1 class="font-mono text-4xl md:text-6xl lg:text-7xl font-bold text-primary tracking-tighter">
              >_ web3ready<span class="animate-blink">|</span>
            </h1>
            <p class="text-cyan font-mono text-sm md:text-lg max-w-2xl border-l-2 border-cyan pl-4 italic">
              "The decentralized future is not a product. It is a protocol."
            </p>
          </div>
          <div class="flex flex-wrap gap-4 pt-4">
            <a href="/manifesto">
              <Button variant="primary" size="lg">
                READ MANIFESTO
              </Button>
            </a>
            <a href="/philosophy">
              <Button variant="outline" size="lg">
                VIEW PRINCIPLES
              </Button>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 3-Beat Hook -->
    <section class="w-full max-w-[1200px] px-6 md:px-20 lg:px-40 py-16">
      <ThreeBeatHook />
    </section>

    <!-- Identity / Manifesto Teaser -->
    <section class="w-full max-w-[1200px] px-6 md:px-20 lg:px-40 py-16 border-t border-primary/10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <div class="lg:col-span-4">
          <h2 class="text-primary font-mono text-xl font-bold sticky top-32 uppercase tracking-widest">
            <span class="text-xs block text-cyan/60 font-normal mb-2">01 // IDENTITY</span>
            The Manifesto
          </h2>
        </div>
        <div class="lg:col-span-8 space-y-6 text-white/70 leading-relaxed font-light text-lg">
          <p>
            The decentralized future is not a product. It is a protocol.
            We build tools, not toll booths &mdash; systems that can't be shut down.
            You are the point: not your product, not your attention, not your data.
          </p>
        </div>
      </div>
    </section>

    <!-- Brief Description -->
    <section class="w-full max-w-[1200px] px-6 md:px-20 lg:px-40 py-16">
      <div class="terminal-border p-8 rounded-sm">
        <p class="text-white/80 leading-relaxed font-light mb-6">
          We synthesize the Cypherpunk warnings, the Autonomist resonance, and thirty years of evidence.
        </p>
        <p class="text-white/60 leading-relaxed font-light mb-6">
          Public good. CC0. Fork it. Challenge it. Build.
        </p>
        <div class="flex gap-4">
          <a href={GITHUB_URL} class="font-mono text-primary text-sm hover:text-white transition-colors">
            [View on GitHub]
          </a>
        </div>
      </div>
    </section>
  </main>
</MainLayout>